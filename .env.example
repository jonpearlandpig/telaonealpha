# Canonical local ShowTELA runtime environment.
# Copy this shape into .env.local and fill real values. Do not commit .env.local.

# Auth
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
AUTH_SECRET=replace_with_at_least_32_random_characters

# Supabase durable runtime cache
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Notion live ShowTELA hydration
NOTION_API_KEY=secret_your_notion_integration_key
NOTION_SHOWTELA_PEOPLE_DB_ID=your_people_database_id
NOTION_SHOWTELA_OPERATIONS_DB_ID=your_operations_database_id
NOTION_SHOWTELA_CONTINUITY_DB_ID=your_continuity_database_id

# Optional Notion databases for richer runtime state
NOTION_SHOWTELA_UNRESOLVED_DB_ID=your_unresolved_database_id
NOTION_SHOWTELA_ARTIFACTS_DB_ID=your_artifacts_database_id
NOTION_TELA_INBOX_DB_ID=your_inbox_database_id

# Accepted legacy aliases. Prefer the canonical NOTION_SHOWTELA_* names above.
# NOTION_CRUSADE_PEOPLE_DB_ID=your_people_database_id
# NOTION_CRUSADE_OPERATIONS_DB_ID=your_operations_database_id
# NOTION_CRUSADE_CONTINUITY_DB_ID=your_continuity_database_id
# NOTION_CRUSADE_EVENTS_DB_ID=your_continuity_database_id
# NOTION_SHOWTELA_EVENTS_DB_ID=your_continuity_database_id
# NOTION_CRUSADE_UNRESOLVED_DB_ID=your_unresolved_database_id
# NOTION_CRUSADE_ARTIFACTS_DB_ID=your_artifacts_database_id

# Optional AI/runtime features
ANTHROPIC_API_KEY=your_anthropic_key
OPENAI_API_KEY=your_openai_key
SHOWTELA_LAST_SEEN_TIMESTAMP=2025-01-01T00:00:00.000Z

# Local operator relay only
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ALLOWED_USER_ID=your_telegram_user_id
