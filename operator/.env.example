# TELAOne Telegram Operator — Required environment variables
# Copy this file to operator/.env and fill in values (never commit operator/.env)

# From BotFather on Telegram (/mybots → your bot → API Token)
TELEGRAM_BOT_TOKEN=

# Your Telegram chat ID — restricts bot to one user (get from @userinfobot)
TELEGRAM_CHAT_ID=8590751282

# GitHub personal access token with Contents + Pull requests write scope
# GitHub → Settings → Developer settings → Personal access tokens → Fine-grained
GITHUB_TOKEN=ghp_

# Absolute path to the repository on this machine
REPO_PATH=/Users/jon/telaonealpha

# Start the bot:
# source operator/.env && ts-node operator/telegram-operator.ts
