# TELAOne Telegram Operator — Required environment variables

# From BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Your Telegram chat ID (get it from @userinfobot) — restricts to one user
TELEGRAM_CHAT_ID=

# GitHub personal access token with repo scope
# Needed for /pr command
GITHUB_TOKEN=ghp_

# Absolute path to the repository on this machine
REPO_PATH=/path/to/telaonealpha
