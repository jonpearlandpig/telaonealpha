# Canonical Vercel environment template.
# Add these in Vercel Project Settings > Environment Variables.

NEXTAUTH_URL=https://your-production-domain.example
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

NOTION_API_KEY=secret_your_notion_integration_key
NOTION_SHOWTELA_PEOPLE_DB_ID=your_people_database_id
NOTION_SHOWTELA_OPERATIONS_DB_ID=your_operations_database_id
NOTION_SHOWTELA_CONTINUITY_DB_ID=your_continuity_database_id

# Optional, but needed for pressure cards, unresolved sheets, media enrichment, and Pearl Drop intake.
NOTION_SHOWTELA_UNRESOLVED_DB_ID=your_unresolved_database_id
NOTION_SHOWTELA_ARTIFACTS_DB_ID=your_artifacts_database_id
NOTION_TELA_INBOX_DB_ID=your_inbox_database_id

ANTHROPIC_API_KEY=your_anthropic_key
OPENAI_API_KEY=your_openai_key
SHOWTELA_LAST_SEEN_TIMESTAMP=2025-01-01T00:00:00.000Z
